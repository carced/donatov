APP_NAME=GameWiwi.com
APP_URL=https://gamewiwi.com
# Used for SEO/canonical URLs only — CSS/JS use relative /assets/ paths
APP_ENV=local
APP_DEBUG=true

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=donatov
DB_USERNAME=donatov
DB_PASSWORD=donatov_secret

DISCOUNT_FACTOR=0.6
DEFAULT_LANG=ru

# Translation: libretranslate | deepl | google | none
TRANSLATE_HTML=false
AUTO_TRANSLATE_ON_READ=false
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com

ADMIN_PASSWORD=changeme
